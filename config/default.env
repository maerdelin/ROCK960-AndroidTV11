# Pinned upstream baseline
ASUS_MANIFEST_URL="https://github.com/TinkerBoard-Android/rockchip-android-manifest.git"
ASUS_MANIFEST_BRANCH="android11-rockchip"
ASUS_MANIFEST_FILE="tinker_board_2-android11-2.0.8.xml"
ASUS_RELEASE_TAG="tinker_board_2-android11-2.0.8"
AOSP_RELEASE_TAG="android-11.0.0_r46"
REPO_IMPLEMENTATION_URL="https://github.com/GerritCodeReview/git-repo"

# Workspace. Put this on a large Linux filesystem (ext4/xfs recommended).
WORKSPACE="${HOME}/android/rock960-atv11-asus"
SOURCE_DIR="${WORKSPACE}/source"
ARTIFACT_DIR="${WORKSPACE}/artifacts"
CCACHE_DIR="${WORKSPACE}/ccache"

# i7-4790 / 16 GiB-safe defaults.
SYNC_JOBS=4
BUILD_JOBS=3
# Old ASUS/Rockchip 4.19 host tools need common-symbol semantics on modern GCC.
KERNEL_HOSTCFLAGS="-fcommon"
MIN_DISK_GB=450
MIN_MEMORY_PLUS_SWAP_GB=28
USE_CCACHE=0
CCACHE_MAX_GB=50

# Product
PRODUCT_NAME="rock960_atv"
BUILD_VARIANT="userdebug"
PRODUCT_MODEL="ROCK960 Android TV"

# Bring-up defaults. AVB can be enabled after first successful boot.
ENABLE_AVB=0
ENABLE_WIDEVINE_L3=1
ENABLE_PLAYREADY=0
ENABLE_GMS=0
ENABLE_GTVS=0
ENABLE_CAMERA=0
ENABLE_ETHERNET=0

# Build environment: auto | docker | host
BUILD_ENV="auto"
DOCKER_IMAGE="rock960-a11-asus-builder:1.2"


# Hardware identity lock: this controller is ONLY for original ROCK960 Model A/B.
TARGET_BOARD_FAMILY="rock960-ab"
WIFI_MODULE="AP6356S"
WIFI_FIRMWARE_FAMILY="BCM4356A2"
