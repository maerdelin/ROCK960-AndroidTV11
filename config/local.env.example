# Copy to config/local.env and edit.
# Example for a 1 TB HDD mounted as /mnt/android-build:
WORKSPACE="/mnt/android-build/rock960-atv11-asus"
SYNC_JOBS=4
BUILD_JOBS=3

# For first bring-up leave AVB off. After a verified boot you can set 1 and rebuild.
ENABLE_AVB=0

# auto uses Docker when available, otherwise host tools.
BUILD_ENV="auto"

# Optional ccache for later incremental builds (uses substantial disk space).
USE_CCACHE=0
CCACHE_MAX_GB=50
