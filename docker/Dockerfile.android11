FROM ubuntu:18.04
ARG DEBIAN_FRONTEND=noninteractive
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USER_NAME=builder

RUN (apt-get update || (sed -i -e 's|archive.ubuntu.com|old-releases.ubuntu.com|g' -e 's|security.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list && apt-get update)) && apt-get install -y --no-install-recommends \
    git git-core gnupg flex bison gperf build-essential zip curl zlib1g-dev \
    gcc-multilib g++-multilib libc6-dev-i386 lib32ncurses5-dev x11proto-core-dev \
    libx11-dev lib32z1-dev libgl1-mesa-dev libxml2-utils xsltproc unzip python \
    python3 python3-dev bc liblz4-tool lz4 m4 python-crypto xz-utils kmod \
    fontconfig libssl-dev parted gawk cpio rsync dosfstools wget sudo udev \
    openjdk-8-jdk device-tree-compiler fakeroot file ca-certificates ccache \
 && rm -rf /var/lib/apt/lists/*

# ASUS 2.0.8 used lz4 1.9.2 explicitly. Prefer it when the archive is reachable,
# but retain the distro lz4 package as a network-safe fallback.
RUN set -eux; \
    cd /tmp; \
    for pkg in \
      https://archive.ubuntu.com/ubuntu/pool/main/l/lz4/liblz4-1_1.9.2-2_amd64.deb \
      https://archive.ubuntu.com/ubuntu/pool/main/l/lz4/lz4_1.9.2-2_amd64.deb \
      https://archive.ubuntu.com/ubuntu/pool/universe/l/lz4/liblz4-tool_1.9.2-2_all.deb; do \
      f="$(basename "$pkg")"; curl -fL --retry 3 "$pkg" -o "$f" || true; \
    done; \
    dpkg -i ./*.deb 2>/dev/null || true; \
    rm -f ./*.deb

RUN groupadd -g ${GROUP_ID} ${USER_NAME} \
 && useradd -m -u ${USER_ID} -g ${GROUP_ID} -s /bin/bash ${USER_NAME} \
 && echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/${USER_NAME}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 USER=${USER_NAME} HOME=/home/${USER_NAME}
USER ${USER_NAME}
WORKDIR /source
